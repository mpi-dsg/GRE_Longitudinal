 #define ALEX_USE_LZCNT 1
 
 namespace alexol {
+
+// ---- contention instrumentation -----------------------------------------------------
+// AlexOL synchronizes with a hybrid scheme: model nodes take an explicit reader-writer
+// lock, data nodes are read optimistically and validated against a version word. (The
+// OptLock in concurrency.h is not included by any translation unit and is unused.) These
+// counters record every point at which a thread is turned away or has to retry.
+//
+// The hypothesis under test: randomizing the bulk-load density spreads restructuring
+// across the whole workload, which lowers its peak but raises the probability that a
+// modification is in flight at any given moment, so threads are turned away more often
+// everywhere. Counters are thread-local, so counting generates no coherence traffic and
+// cannot manufacture the contention it is meant to measure.
+#include <cstdint>
+#include <mutex>
+#include <vector>
+namespace lock_stats {
+struct Counters {
+  uint64_t calls = 0, retry = 0, parentspin = 0;
+  uint64_t lock_busy = 0;         // data node was write-locked when read optimistically
+  uint64_t validate_fail = 0;     // optimistic validation saw the version change
+  uint64_t read_denied = 0;       // model-node read lock refused
+  uint64_t write_denied = 0;      // write lock refused
+};
+inline std::mutex &reg_mtx() { static std::mutex m; return m; }
+inline std::vector<Counters *> &registry() { static std::vector<Counters *> v; return v; }
+inline bool &enabled() { static bool e = false; return e; }
+inline Counters &local() {
+  thread_local Counters c;
+  thread_local bool reg = [] {
+    std::lock_guard<std::mutex> g(reg_mtx());
+    registry().push_back(&c);
+    return true;
+  }();
+  (void)reg;
+  return c;
+}
+inline Counters total() {
+  Counters t;
+  std::lock_guard<std::mutex> g(reg_mtx());
+  for (auto *c : registry()) {
+    t.calls += c->calls;
+    t.retry += c->retry;
+    t.parentspin += c->parentspin;
+    t.lock_busy += c->lock_busy;
+    t.validate_fail += c->validate_fail;
+    t.read_denied += c->read_denied;
+    t.write_denied += c->write_denied;
+  }
+  return t;
+}
+}  // namespace lock_stats
+
