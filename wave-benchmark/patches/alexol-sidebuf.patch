+  // Same search without the statistics counter. The side-buffer paths search an old node
+  // concurrently from several threads, so they must not write to it at all.
+  template <class K>
+  inline int exponential_search_upper_bound_ro(int m, const K &key) const {
+    int bound = 1;
+    int l, r;
+    if (key_greater(ALEX_DATA_NODE_KEY_AT(m), key)) {
+      int size = m;
+      while (bound < size && key_greater(ALEX_DATA_NODE_KEY_AT(m - bound), key)) bound *= 2;
+      l = m - std::min<int>(bound, size);
+      r = m - bound / 2;
+    } else {
+      int size = data_capacity_ - m;
+      while (bound < size && key_lessequal(ALEX_DATA_NODE_KEY_AT(m + bound), key)) bound *= 2;
+      l = m + bound / 2;
+      r = m + std::min<int>(bound, size);
+    }
+    return binary_search_upper_bound(l, r, key);
+  }
