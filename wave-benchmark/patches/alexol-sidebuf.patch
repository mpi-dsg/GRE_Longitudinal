+// Background expansion. Every node of a bulk-loaded cohort reaches the expansion threshold
+// at the same insert count, and the insert that reaches it pays for the whole restructuring.
+// Here, an insert that takes a node past a lower "soft" threshold only enqueues it, and a
+// background thread performs the modification before the node reaches the hard threshold.
+// Detection stays synchronized; execution leaves the insert path and is serialized by the
+// queue, so at most one node per background thread is under modification at a time. If
+// the queue falls behind, the hard threshold still fires on the insert path as before.
+namespace bgexp {
+inline bool &enabled() { static bool e = false; return e; }
+// Soft threshold as a fraction of the hard one. 0.9375 = density 0.75 against 0.8.
+inline double &soft() { static double f = 0.9375; return f; }
+inline int &threads() { static int n = 1; return n; }
+// Set by the index when its background thread starts. The driver pauses the thread outside
+// timed regions: whole-structure walks such as memory accounting are not safe against a
+// concurrent rebuild, and untimed background work would flatter the design.
+inline std::function<void(bool)> &pause_hook() { static std::function<void(bool)> f; return f; }
+}  // namespace bgexp
