+  // ---- sidealways (see sidebuf::always) ----
+  int side_count() const {
+    SideBuf *sb = __atomic_load_n(&side_, __ATOMIC_ACQUIRE);
+    return sb == nullptr ? 0 : __atomic_load_n(&sb->n, __ATOMIC_RELAXED);
+  }
+  // The node's permanent buffer, created on first use. Exactly one buffer per node: the
+  // pointer only goes from null to a buffer, by CAS, and the buffer is freed with the node.
+  SideBuf *ensure_side() {
+    SideBuf *sb = __atomic_load_n(&side_, __ATOMIC_ACQUIRE);
+    if (sb != nullptr) return sb;
+    auto *fresh = new SideBuf;
+    if (__atomic_compare_exchange_n(&side_, &sb, fresh, false, __ATOMIC_ACQ_REL,
+                                    __ATOMIC_ACQUIRE))
+      return fresh;
+    delete fresh;
+    return sb;  // another thread published one; the failed CAS loaded it
+  }
+  // The modification ALEX's insert path would choose if the buffered keys were in the array.
+  // For a merge (buffer full or sealed): a catastrophic cost splits; at the expansion
+  // threshold, the usual split/retrain/expand choice; below it, code 7 compacts the node at
+  // its current capacity, the counterpart of ALEX inserting into the existing array. For the
+  // background expander, the same choice as bg_smo_code. A node whose array is empty (all its
+  // keys buffered) has nothing to split or retrain on and is resized. Caller holds the lock.
+  int always_smo_code(bool merge) const {
+    double total = num_keys_ + side_count();
+    if (num_keys_ == 0) return (!merge || total >= expansion_threshold_) ? 5 : 7;
+    if (merge) {
+      if (catastrophic_cost()) return 2;
+      if (total < expansion_threshold_) return 7;
+    }
+    if (significant_cost_deviation()) return 1;
+    if (catastrophic_cost()) return 2;
+    if (total > max_slots_ * kMinDensity_) return 3;
+    return 5;
+  }
+  // Density to pass to resize_from_existing so that the replacement has the target density
+  // once the buffered keys are drained into it (code 7: keep the current capacity).
+  double always_density(int fail, double target) const {
+    if (num_keys_ == 0) return target;
+    // resize_from_existing truncates num_keys_ / density; the half slot keeps that at
+    // data_capacity_ instead of one below it after rounding.
+    if (fail == 7) return num_keys_ / (data_capacity_ + 0.5);
+    return target * num_keys_ / (num_keys_ + side_count());
+  }
+
+  // Insert without the node lock: the array of a live node is never written in place in this
+  // mode (only a root expansion does, after marking the buffer excl). The duplicate check
+  // reads the array before taking the spinlock; a rebuild or root expansion seals the buffer
+  // under the same spinlock before it drains or modifies anything, so an append that finds the
+  // buffer open is drained into the replacement, and an array read that finds excl clear
+  // preceded any in-place modification.
+  // Returns 0 (appended), 6 (appended; enqueue for the background expander), -1 (duplicate),
+  // 4 (restart), or 7 (buffer full or sealed; lock now held, caller merges and restarts).
+  std::pair<int, int> insert_always(const T &key, const P &payload) {
+    SideBuf *sb = ensure_side();
+    int pos = exponential_search_upper_bound_ro(predict_position(key), key) - 1;
+    bool dup = !allow_duplicates && pos >= 0 && key_equal(ALEX_DATA_NODE_KEY_AT(pos), key);
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    sb->lock();
+    if (!sb->excl) {
+      if (dup) { sb->unlock(); return {-1, pos}; }
+      for (int i = 0; !allow_duplicates && i < sb->n; i++) {
+        if (key_equal(sb->k[i], key)) { sb->unlock(); return {-1, -1}; }
+      }
+      if (!sb->sealed && sb->n < sidebuf::kCap) {
+        sb->k[sb->n] = key;
+        sb->v[sb->n] = payload;
+        __atomic_store_n(&sb->n, sb->n + 1, __ATOMIC_RELAXED);
+        bool enqueue = false;
+        if (bgexp::enabled() && !bg_queued_ &&
+            num_keys_ + sb->n >= bgexp::soft() * expansion_threshold_) {
+          bg_queued_ = true;
+          enqueue = true;
+        }
+        sb->unlock();
+        if (lock_stats::enabled()) lock_stats::local().side_ins++;
+        return {enqueue ? 6 : 0, -1};
+      }
+    }
+    sb->unlock();
+    // Full or sealed, or a root expansion is modifying the array: merge if the node is free.
+    // A retired node stays locked, so holding the lock means this node is still live.
+    if (!try_get_lock()) {
+      if (lock_stats::enabled()) { lock_stats::local().side_full++; lock_stats::trace().sealed++; }
+      return {4, -1};
+    }
+    __atomic_store_n(&smo_, true, __ATOMIC_RELAXED);
+    return {7, -1};
+  }
+
   // Rebuild protocol, called by the lock holder. open_side before copying from this node,
   // then seal_side and drain into the replacement before publishing it.
   SideBuf *open_side() {
     if (!sidebuf::enabled()) return nullptr;
+    if (sidebuf::always()) return ensure_side();  // the node's permanent buffer
     auto *sb = new SideBuf;
     __atomic_store_n(&side_, sb, __ATOMIC_RELEASE);
     return sb;
