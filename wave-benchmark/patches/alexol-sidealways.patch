+  // sidealways, node locked. A rebuild or merge only reads the array, but a root expansion
+  // modifies it in place and marks the buffer excl first. The array is read before taking
+  // the spinlock: if excl is still clear then, the read preceded the modification.
+  bool find_payload_locked_always(SideBuf *sb, const T &key, P *payload, bool *found) {
+    if (lock_stats::enabled()) lock_stats::local().side_read++;
+    int pos = exponential_search_upper_bound_ro(predict_position(key), key) - 1;
+    bool hit = !(pos < 0 || !key_equal(ALEX_DATA_NODE_KEY_AT(pos), key));
+    P p = hit ? get_payload(pos) : P();
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    sb->lock();
+    if (sb->excl) { sb->unlock(); return false; }
+    for (int i = 0; !hit && i < sb->n; i++) {
+      if (key_equal(sb->k[i], key)) { p = sb->v[i]; hit = true; }
+    }
+    sb->unlock();
+    *found = hit;
+    if (hit) *payload = p;
     return true;
   }
 
