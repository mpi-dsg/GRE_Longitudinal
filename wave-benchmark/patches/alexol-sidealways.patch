# sidealways ablation for ALEX-OL: a permanent, XIndex-style delta buffer in every data node.
#
# Applies after alexol-sidebuf.patch, in alexol/src:
#   patch -p0 -d alexol/src -i alexol-sidealways.patch
# Driver flag (bench.cpp, next to `side`):
#   else if (a == "sidealways") { alexol::sidebuf::enabled() = true; alexol::sidebuf::always() = true; }
#
# Off by default. Every change is guarded by sidebuf::always(); with it off, default, side and
# bg runs execute the same code as before (single-thread memory per batch is identical).
# With it on:
#   - each data node has one SideBuf (kCap 1024), created on first use by CAS, freed with the node;
#   - inserts append to it without the node lock and never write the array; the duplicate check
#     reads the array, then takes the spinlock and checks the seal, as the side-buffer path does;
#   - lookups search the array and, on a miss, the buffer (XIndex read path);
#   - a full or sealed buffer makes the inserting thread take the node lock and rebuild the node
#     (new fail code 7 from AlexDataNode::insert): ALEX's split/retrain/expand choice computed on
#     array plus buffered keys, or, below the expansion threshold, a copy at the current capacity
#     (fail 7 in run_smo_body); the buffer is drained into the replacement, which starts empty;
#   - rebuilds (foreground, background, splits) use the permanent buffer as their side buffer;
#   - root expansion, the one in-place modification of a live node's array, seals the outermost
#     node's buffer and marks it excl first (readers and inserters restart), counts buffered keys
#     in the new domain, and moves buffered keys routed to the new nodes into them;
#   - memory accounting (Alex::data_size) adds sizeof(SideBuf) for every allocated buffer.
--- alex_nodes.h
+++ alex_nodes.h
@@ -162,6 +162,13 @@
 namespace sidebuf {
 inline bool &enabled() { static bool e = false; return e; }
 constexpr int kCap = 1024;
+// Ablation (implies enabled): every data node keeps a permanent delta buffer, as XIndex does.
+// Inserts append to the buffer without the node lock and never write the array; lookups
+// search the array and, on a miss, the buffer. A full or sealed buffer makes the inserting
+// thread merge the node: it takes the lock and rebuilds the node exactly as a structural
+// modification does, draining the buffer into the replacement. Rebuilds use the permanent
+// buffer as their side buffer.
+inline bool &always() { static bool a = false; return a; }
 }  // namespace sidebuf
 
